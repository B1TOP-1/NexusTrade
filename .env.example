# Binance API 凭据模板
# 复制为 .env 并填入真实 Key（.env 已被 .gitignore 忽略，不会提交）
#
#   cp .env.example .env
#
# 主网 API Key（fapi.binance.com）
# 创建位置：Binance → API 管理 → 创建 API → 启用合约交易权限
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 可选：测试网 Key（testnet.binancefuture.com）
# 创建位置：https://testnet.binancefuture.com/  → API 管理
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=
